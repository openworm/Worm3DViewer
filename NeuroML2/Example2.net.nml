<neuroml xmlns="http://www.neuroml.org/schema/neuroml2"  xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.neuroml.org/schema/neuroml2 https://raw.github.com/NeuroML/NeuroML2/development/Schemas/NeuroML2/NeuroML_v2.3.1.xsd" id="Example2">
    <notes>Demo of cell with spines</notes>
    <cell id="OneSeg">
        <morphology id="mm">
            <segment id="0" name="soma">
                <proximal x="0.0" y="0.0" z="0.0" diameter="10.0"/>
                <distal x="20.0" y="0.0" z="0.0" diameter="10.0"/>
            </segment>
            <segmentGroup id="all">
                <member segment="0"/>
            </segmentGroup>
        </morphology>
    </cell>
    <cell id="TwoSeg">
        <morphology id="mm">
            <segment id="0" name="soma">
                <proximal x="0.0" y="0.0" z="0.0" diameter="10.0"/>
                <distal x="20.0" y="0.0" z="0.0" diameter="10.0"/>
            </segment>
            <segment id="1" name="soma">
                <parent segment="0"/>
                <proximal x="20.0" y="0.0" z="0.0" diameter="5.0"/>
                <distal x="40.0" y="0.0" z="0.0" diameter="5.0"/>
            </segment>
            <segmentGroup id="all">
                <member segment="0"/>
                <member segment="1"/>
            </segmentGroup>
        </morphology>
    </cell>
    <cell id="ThreeSeg">
        <morphology id="mm">
            <segment id="0" name="soma">
                <proximal x="0.0" y="0.0" z="0.0" diameter="10.0"/>
                <distal x="0.0" y="0.0" z="0.0" diameter="10.0"/>
            </segment>
            <segment id="1" name="taper0">
                <parent segment="0"/>
                <proximal x="0.0" y="0.0" z="10.0" diameter="8.0"/>
                <distal x="0.0" y="0.0" z="20.0" diameter="4.0"/>
            </segment>
            <segment id="2" name="taper1">
                <parent segment="1"/>
                <proximal x="0.0" y="0.0" z="20.0" diameter="3.0"/>
                <distal x="0.0" y="0.0" z="30.0" diameter="2.0"/>
            </segment>
            <segment id="3" name="taper2">
                <parent segment="2"/>
                <proximal x="0.0" y="0.0" z="30.0" diameter="2.0"/>
                <distal x="0.0" y="0.0" z="50.0" diameter="2.0"/>
            </segment>
            <segment id="4" name="side">
                <parent segment="3"/>
                <proximal x="0.0" y="10.0" z="40.0" diameter="3.0"/>
                <distal x="4.0" y="5.0" z="50.0" diameter="1.0"/>
            </segment>
            <segment id="5" name="side2">
                <parent segment="3"/>
                <proximal x="10.0" y="0.0" z="50.0" diameter="2.0"/>
                <distal x="10.0" y="0.0" z="60.0" diameter="2.0"/>
            </segment>
            <segmentGroup id="all">
                <member segment="0"/>
                <member segment="1"/>
                <member segment="2"/>
                <member segment="3"/>
                <member segment="4"/>
                <member segment="5"/>
            </segmentGroup>
        </morphology>
    </cell>
    <network id="Example2">
        <notes>Demo of cell with spines</notes>
        <!--
        <population id="Pop_OneSeg" component="OneSeg" size="2" type="populationList">
            <property tag="color" value="0 .4 0"/>
            <instance id="0">
                <location x="0.0" y="0.0" z="0.0"/>
            </instance>
            <instance id="1">
                <location x="50.0" y="40.0" z="-30.0"/>
            </instance>
        </population>
        <population id="Pop_TwoSeg" component="TwoSeg" size="2" type="populationList">
            <property tag="color" value="1 .4 0"/>
            <instance id="0">
                <location x="0.0" y="100.0" z="0.0"/>
            </instance>
            <instance id="1">
                <location x="30.0" y="0.0" z="0.0"/>
            </instance>
        </population>-->
        <population id="Pop_ThreeSeg" component="ThreeSeg" size="2" type="populationList">
            <property tag="color" value=".2 1 .3"/>
            <instance id="0">
                <location x="20.0" y="120.0" z="20.0"/>
            </instance>
            <instance id="1">
                <location x="100.0" y="80.0" z="50.0"/>
            </instance>
        </population>
    </network>
</neuroml>
